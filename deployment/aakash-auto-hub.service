[Unit]
Description=Aakash Auto Hub Gunicorn service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/aakash-auto-hub
EnvironmentFile=/var/www/aakash-auto-hub/.env
ExecStart=/var/www/aakash-auto-hub/.venv/bin/gunicorn --workers 3 --bind unix:/run/aakash-auto-hub.sock aakash_auto_hub.wsgi:application
Restart=always
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
